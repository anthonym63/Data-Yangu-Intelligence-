# --- Python ---
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# --- Secrets ---
.env
.env.*
!.env.example
.streamlit/secrets.toml

# --- Customer data (NEVER commit) ---
# This platform ingests real SME spreadsheets. Nothing derived from a
# customer upload may enter version control.
*.csv
*.xlsx
*.xls
data/uploads/
uploads/

# Synthetic fixtures and the demo sample are the deliberate exceptions.
!tests/fixtures/*.csv
!tests/fixtures/*.xlsx
!data/samples/*.csv

# --- Generated artifacts ---
claude_outputs/
audit_exports/
*.log
*.duckdb

# --- OS / editor ---
.DS_Store
Thumbs.db

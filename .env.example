# Copy to .env and fill in. .env is gitignored - never commit a real key.
#
# The Anthropic API key is the only secret this project needs. It is read by the
# zero-argument anthropic.Anthropic() constructor in src/frontend/mcp_planner.py.
# Upload, profiling, cleaning, analytics and the audit trail all work without it;
# only "Generate cleaning plan" needs Claude.
ANTHROPIC_API_KEY=
